  "faq": [
    {
      "question": "Can I change plans at any time?",
      "answer": "Yes. You can upgrade or downgrade your plan at any time directly from the admin panel, with no penalties or red tape."
    },
    {
      "question": "How do AI credits work?",
      "answer": "Every plan includes a monthly quota of AI credits, used by features like smart extraction and agents. Credits are non-cumulative and renew every month."
    },
    {
      "question": "What happens after the trial period?",
      "answer": "At the end of the 7 free days, you can choose the ideal plan to keep using the platform. No credit card is required to start the trial."
    },
    {
      "question": "What payment methods are accepted?",
      "answer": "We accept credit card, bank slip (boleto), and invoice billing for annual contracts and Enterprise plans."
    },
    {
      "question": "Do the plans include implementation?",
      "answer": "The Starter, Business, and Corporate plans include guided onboarding. For the Enterprise plan, we offer dedicated implementation with our team of specialists."
    },
    {
      "question": "Do you offer a discount for annual contracts?",
      "answer": "Yes. By choosing annual billing, you save up to 30% compared to the monthly price, on any of the Starter, Business, or Corporate plans."
    }
